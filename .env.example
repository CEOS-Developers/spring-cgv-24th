CGV_IMAGE=spring-cgv-24th:local
APP_PORT=80
# Supply base64 encoding of at least 32 random bytes. This placeholder is not a key.
CGV_JWT_SECRET_BASE64=replace-with-base64-encoded-random-bytes

# compose.yml creates a NEW learning database in its named volume.
MYSQL_DATABASE=cgv_deploy
MYSQL_USER=cgv_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# compose-rds.yml requires these instead of the MYSQL_* settings above.
# Use a NEW learning database; configure TLS in the JDBC URL for external MySQL.
SPRING_DATASOURCE_URL=jdbc:mysql://replace-with-rds-host:3306/cgv_deploy?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=replace-with-rds-app-user
SPRING_DATASOURCE_PASSWORD=replace-with-rds-app-password

# Optional for startup. Payment requests require API integration test keys.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
