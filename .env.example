# 사용법: cp -n .env.example .env 후 실제 값을 채우세요. (.env는 커밋 금지)

# Database
DB_HOST=change-me
DB_NAME=change-me
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_PORT=change-me

# Jwt
JWT_SECRET=change-me-to-32-chars-or-longer

# Admin
ADMIN_TOKEN=change-me

# Toss Payments
TOSS_SECRET_KEY=change-me
TOSS_WEBHOOK_SECRET=change-me
