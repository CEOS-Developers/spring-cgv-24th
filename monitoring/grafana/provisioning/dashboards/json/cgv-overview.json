{
  "uid": "cgv-overview",
  "title": "CGV API Overview",
  "tags": ["cgv", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Application up", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=\"cgv-api\"}", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}},
    {"id": 2, "title": "Requests / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"cgv-api\",uri!~\"/actuator/.*\"}[5m]))", "legendFormat": "requests", "refId": "A"}]},
    {"id": 3, "title": "5xx / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"cgv-api\",status=~\"5..\"}[5m]))", "legendFormat": "5xx", "refId": "A"}]},
    {"id": 4, "title": "p95 latency by URI", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"cgv-api\",uri!~\"/actuator/.*\"}[5m])))", "legendFormat": "{{uri}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 5, "title": "JVM heap used", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(jvm_memory_used_bytes{job=\"cgv-api\",area=\"heap\"})", "legendFormat": "heap", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 6, "title": "Snack operations / 5m", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (action) (increase(cgv_snack_orders_total{job=\"cgv-api\"}[5m]))", "legendFormat": "{{action}}", "refId": "A"}]},
    {"id": 7, "title": "Payment operations / 5m", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (action) (increase(cgv_payment_operations_total{job=\"cgv-api\"}[5m]))", "legendFormat": "{{action}}", "refId": "A"}]}
  ]
}
