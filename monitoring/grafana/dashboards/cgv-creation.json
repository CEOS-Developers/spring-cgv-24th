{
  "uid": "cgv-creation-monitoring",
  "title": "CGV 예매·매점 주문 생성",
  "description": "예매 생성과 매점 주문 생성 API의 요청량, 응답 시간, 오류와 DB 커넥션 대기를 비교한다.",
  "tags": [
    "cgv",
    "monitoring"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "생성 요청량",
      "description": "API별 초당 요청 수. 모든 HTTP 응답 코드를 포함한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/reservations\"}[$__rate_interval]))",
          "legendFormat": "예매 생성",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/theaters/{theaterId}/store/orders\"}[$__rate_interval]))",
          "legendFormat": "매점 주문 생성",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "예매 생성"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "매점 주문 생성"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "생성 응답 시간 p95",
      "description": "API별 요청의 95%가 완료된 시간을 히스토그램으로 추정한다. 모든 HTTP 응답 코드를 포함한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cgv\",method=\"POST\",uri=\"/api/reservations\"}[$__rate_interval])))",
          "legendFormat": "예매 생성",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cgv\",method=\"POST\",uri=\"/api/theaters/{theaterId}/store/orders\"}[$__rate_interval])))",
          "legendFormat": "매점 주문 생성",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "예매 생성"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "매점 주문 생성"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "생성 5xx 오류율",
      "description": "API별 전체 요청 중 5xx 응답의 비율. 요청이 없는 시간은 비워둔다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/reservations\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/reservations\"}[$__rate_interval])) > 0)",
          "legendFormat": "예매 생성",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/theaters/{theaterId}/store/orders\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/theaters/{theaterId}/store/orders\"}[$__rate_interval])) > 0)",
          "legendFormat": "매점 주문 생성",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "예매 생성"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "매점 주문 생성"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB 커넥션 대기 수",
      "description": "CGV 앱에서 HikariCP 커넥션을 기다리는 작업 수. 응답 시간 상승 구간과 비교한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(hikaricp_connections_pending{job=\"cgv\"})",
          "legendFormat": "대기 중",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "예매 생성 · 응답 코드별 RPS",
      "description": "201은 예매 생성 성공이다. 409에는 이미 예매된 좌석이나 상영 시작 등의 요청 충돌이 포함된다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/reservations\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "201"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "409"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "매점 주문 생성 · 응답 코드별 RPS",
      "description": "201은 매점 주문 생성 성공이다. 409에는 재고 부족 등의 요청 충돌이 포함된다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"cgv\",method=\"POST\",uri=\"/api/theaters/{theaterId}/store/orders\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "201"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "409"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
