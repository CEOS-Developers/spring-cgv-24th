{
  "uid": "cgv-overview",
  "title": "CGV Overview",
  "description": "로컬 CGV API 상태, 요청 처리량·지연, JVM·DB 커넥션 풀, 좌석·결제 지표와 애플리케이션 로그",
  "tags": [
    "cgv",
    "local"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Prometheus 수집 상태",
      "description": "CGV Actuator에서 메트릭을 수집할 수 있는지 보여줍니다.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "up{job=\"cgv\"}",
          "legendFormat": "CGV",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx 비율",
      "description": "최근 요청 중 5xx 응답 비율입니다. 측정 구간에 매핑된 API 요청이 없으면 No data로 표시됩니다.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"cgv\",uri=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"cgv\",uri=~\"/api/.*\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{job=\"cgv\",uri=~\"/api/.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API 요청률",
      "description": "Spring이 기록한 HTTP 메서드와 /api/ 경로 템플릿별 초당 요청 수입니다.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"cgv\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API p95 응답 시간",
      "description": "HTTP 메서드와 경로 템플릿별 요청의 95%가 이 시간 안에 처리됩니다. 요청이 있는 구간만 표시합니다.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=\"cgv\",uri=~\"/api/.*\"}[$__rate_interval]))) and on (method, uri) (sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"cgv\",uri=~\"/api/.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM 힙 메모리",
      "description": "JVM의 힙 사용량과 최대 힙 용량입니다.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"cgv\",area=\"heap\"})",
          "legendFormat": "Used",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{job=\"cgv\",area=\"heap\"} > 0)",
          "legendFormat": "Max",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM 스레드",
      "description": "JVM에서 살아 있는 스레드의 수입니다.",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "jvm_threads_live_threads{job=\"cgv\"}",
          "legendFormat": "Live",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hikari 커넥션 풀",
      "description": "풀별 사용 중인 DB 커넥션 수와 커넥션을 기다리는 스레드 수를 보여줍니다.",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "hikaricp_connections_active{job=\"cgv\"}",
          "legendFormat": "{{pool}} active",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "hikaricp_connections_pending{job=\"cgv\"}",
          "legendFormat": "{{pool}} pending",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "좌석 선점 충돌",
      "description": "선택한 시간 범위에서 발생한 좌석 선점 충돌을 사유별로 집계합니다.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "sum by (reason) (increase(cgv_seat_hold_conflicts_total{job=\"cgv\"}[$__range]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "결제 결과 UNKNOWN",
      "description": "선택한 시간 범위에서 결제 작업이 UNKNOWN을 응답한 횟수입니다. 작업 유형과 결제 대상별로 표시합니다.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cgv-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cgv-prometheus"
          },
          "expr": "sum by (type, target) (increase(cgv_payment_operation_responses_total{job=\"cgv\",status=\"UNKNOWN\"}[$__range]))",
          "legendFormat": "{{type}} / {{target}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "wideLayout": true
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "CGV 로그",
      "description": "선택한 시간 범위의 JSON 로그입니다. Explore에서 {app=\"cgv\"} | json 뒤에 requestId 또는 errorCode 조건을 추가할 수 있습니다.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "cgv-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "cgv-loki"
          },
          "expr": "{app=\"cgv\"}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
