loki.source.file "cgv" {
	targets = [{
		__path__ = "/var/log/cgv/cgv.log",
		app      = "cgv",
	}]
	forward_to = [loki.process.cgv.receiver]

	// The application can create the file after Alloy has started.
	file_match {
		enabled     = true
		sync_period = "3s"
	}
}

loki.process "cgv" {
	// Keep the original JSON searchable; use the event time for the dashboard's time range.
	stage.json {
		expressions = {
			timestamp = "\"@timestamp\"",
			event     = "event",
		}
	}

	stage.labels {
		values = {event = "event"}
	}

	stage.match {
		selector            = "{app=\"cgv\",event!~\"http_request|payment_operation|unexpected_exception|food_checkout_cleanup_failed\"}"
		action              = "drop"
		drop_counter_reason = "non_application_event"
	}

	stage.label_drop {
		values = ["event"]
	}

	stage.timestamp {
		source            = "timestamp"
		format            = "RFC3339Nano"
		action_on_failure = "skip"
	}
	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
