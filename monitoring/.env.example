# 모니터링 EC2 ~/cgv-monitoring/.env 템플릿 (cp .env.example .env && chmod 600 .env)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# 기본값은 t3.micro(1GiB) 기준이다. t3.small 이상이면 두 배 정도로 올려도 된다
PROMETHEUS_MEM_LIMIT=256m
LOKI_MEM_LIMIT=256m
LOKI_GOMEMLIMIT=200MiB
GRAFANA_MEM_LIMIT=320m
GRAFANA_GOMEMLIMIT=256MiB

PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
