# EC2 /home/ubuntu/cgv/.env 템플릿 (cp .env.deploy.example .env && chmod 600 .env)
# 첫 배포 전에는 아직 없는 태그여도 괜찮습니다. 배포 성공 시 deploy.sh가 실제 이미지로 갱신합니다.
APP_IMAGE=dockerhub-username/cgv:initial
APP_PORT=8080

# MySQL 컨테이너 초기화(MYSQL_DATABASE/USER/PASSWORD)와 Spring Boot 접속에 함께 사용합니다.
# 볼륨이 처음 만들어질 때만 반영되므로, 이후 값을 바꿔도 기존 DB 계정은 바뀌지 않습니다.
DB_NAME=cgv
DB_USERNAME=cgv
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DB_URL=jdbc:mysql://db:3306/cgv?allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8

JWT_SECRET=change-me-at-least-32-bytes-random-string
TOSS_CLIENT_KEY=test_ck_change-me
TOSS_SECRET_KEY=test_sk_change-me

ADMIN_SEED_ENABLED=false
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=

APP_MEM_LIMIT=768m
DB_MEM_LIMIT=512m
